# Copy this file to .env and edit. Never commit .env.
PORT=3001
NODE_ENV=development

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin account created on first start (required in production).
ADMIN_EMAIL=admin@hazyeats.demo
ADMIN_PASSWORD=Demo@1234

# Demo accounts (buyer, driver, KFC store). On by default in development, off in production.
SEED_DEMO=true

# Flat delivery fee in cents (2000 = R20.00)
DELIVERY_FEE_CENTS=2000

# Google sign-in. Leave blank to hide the button.
GOOGLE_CLIENT_ID=

# Set COOKIE_SECURE=true when serving over HTTPS. Set TRUST_PROXY=1 behind nginx/Caddy/Cloudflare.
COOKIE_SECURE=
TRUST_PROXY=
